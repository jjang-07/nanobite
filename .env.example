# Local demo: no API keys or paid services required.
MAIL_PROVIDER=local
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Set to an installed local model, or leave blank for local model discovery.
OLLAMA_MODEL=
REQUESTER_IDENTITY=alice-agent@startup.local
RESPONDER_IDENTITY=sdk-help@acme.local
APPROVER_EMAIL=bob@acme.local
APPROVER_NAME=Bob
CONTEXTPR_DB=./data/contextpr.db
DASHBOARD_PORT=8787
DASHBOARD_PUBLIC_URL=http://localhost:8787
POLL_WAIT_SECONDS=0
TRANSCRIPTS_DIR=./demo/fixtures

# Optional cloud integrations are used only when explicitly selected above.
PRIMITIVE_API_KEY=
PRIMITIVE_API_KEY_REQUESTER=
PRIMITIVE_API_KEY_RESPONDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
