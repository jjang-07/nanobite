# Demo: local requests and human approvals, Claude for drafting.
# Add your Claude key to your own ignored .env file; never commit it.
MAIL_PROVIDER=local
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional free/local model: set MODEL_PROVIDER=ollama and select an installed model.
# The application never downloads models and rejects cloud Ollama models.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

REQUESTER_IDENTITY=yunha-agent@startup.local
RESPONDER_IDENTITY=sdk-help@acme.local
APPROVER_EMAIL=reviewer@acme.local
APPROVER_NAME=Reviewer
CONTEXTPR_DB=./data/contextpr.db
DASHBOARD_PORT=8787
DASHBOARD_PUBLIC_URL=http://127.0.0.1:8787
POLL_WAIT_SECONDS=0
TRANSCRIPTS_DIR=./demo/fixtures

# Live email through Primitive (hackathon demo). Leave blank for the local inbox.
# To enable: MAIL_PROVIDER=primitive, put the key here, POLL_WAIT_SECONDS=3, and set
#   REQUESTER_IDENTITY=yunha-agent@<subdomain>.primitive.email
#   RESPONDER_IDENTITY=sdk-help@<subdomain>.primitive.email
#   APPROVER_EMAIL=<your real inbox; send an email to the responder first>
PRIMITIVE_API_KEY=
PRIMITIVE_API_KEY_REQUESTER=
PRIMITIVE_API_KEY_RESPONDER=

# MCP over HTTP: started with the worker when a token is set (stdio MCP via `npm run mcp` always works).
# Generate a token with: openssl rand -hex 24
MCP_HTTP_PORT=8788
MCP_HTTP_TOKEN=
# Extra Host values to accept, comma separated, e.g. a tunnel hostname. Keep the bearer token in front of any tunnel.
MCP_HTTP_ALLOWED_HOSTS=
