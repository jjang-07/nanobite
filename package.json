{
  "name": "nanobite",
  "version": "0.1.0",
  "description": "Small, human-approved bites of context between companies' coding agents, over MCP and email.",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "mcp": "node --env-file-if-exists=.env src/mcp/server.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "reset": "node --env-file-if-exists=.env scripts/reset.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "demo:acme": "node demo/acme-sdk/server.ts",
    "demo:checkout": "node demo/yunha-app/server.ts",
    "demo:test": "node --test demo/yunha-app/concurrent-retry.test.ts",
    "smoke:primitive": "node --env-file-if-exists=.env scripts/smoke-primitive.ts",
    "benchmark": "node --env-file-if-exists=.env scripts/benchmark.ts",
    "stats:sessions": "node scripts/session-stats.ts",
    "connect": "node --env-file-if-exists=.env scripts/connect-agent.ts",
    "chatgpt": "node --env-file-if-exists=.env scripts/chatgpt-tunnel.ts",
    "preflight": "node --env-file-if-exists=.env scripts/preflight.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
